<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS solo por UDP (sin memoria compartida).
     En este WSL la memoria compartida deja de entregar datos entre procesos.
     Uso: export FASTRTPS_DEFAULT_PROFILES_FILE=<ruta a este archivo> -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>solo_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="participante_solo_udp" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>solo_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
